+#[cfg(all(test, feature = "parallel"))]
+mod deferred_bvh_join_tests {
+    use super::*;
+
+    #[test]
+    #[should_panic(expected = "the deferred BVH optimization task died")]
+    fn join_executes_a_queued_sender_on_one_worker() {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(1)
+            .build()
+            .unwrap()
+            .install(|| {
+                let mut pipeline = PhysicsPipeline::new();
+                let (tx, rx) = std::sync::mpsc::channel();
+                rayon::spawn(move || drop(tx));
+                *pipeline.deferred_bvh.get_mut().unwrap() = Some(rx);
+                // Deliberately bypass the one-worker inline guard to prove the
+                // join drives a queued task even when no thief can help it.
+                pipeline.join_deferred_bvh_optimize(&mut BroadPhaseBvh::new());
+            });
+    }
+
+    #[test]
+    #[should_panic(expected = "the deferred BVH optimization task died")]
+    fn join_waits_for_a_running_sender() {
+        let mut pipeline = PhysicsPipeline::new();
+        let (tx, rx) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            std::thread::sleep(std::time::Duration::from_millis(100));
+            drop(tx);
+        });
+        *pipeline.deferred_bvh.get_mut().unwrap() = Some(rx);
+        pipeline.join_deferred_bvh_optimize(&mut BroadPhaseBvh::new());
+    }
